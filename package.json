{
  "name": "quimica-interactiva",
  "private": true,
  "version": "0.1.0",
  "description": "Química general, inorgánica y orgánica interactiva en 2D/3D",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "datos": "node scripts/descargar-isotopos.mjs && node scripts/descargar-elementos.mjs && node scripts/descargar-constantes.mjs && node scripts/descargar-masas-referencia.mjs",
    "iconos": "node scripts/generar-iconos.mjs"
  },
  "dependencies": {
    "@rdkit/rdkit": "^2026.9.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "fuse.js": "^7.5.0",
    "katex": "^0.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "three": "^0.169.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "engines": {
    "node": ">=20"
  }
}
