  "reglas": [
    { "texto": "Los compuestos de los metales alcalinos (Li⁺, Na⁺, K⁺…) y del amonio (NH₄⁺) son solubles.", "cationes": ["Li+", "Na+", "K+", "NH4+"], "aniones": "*", "resultado": "soluble" },
    { "texto": "Los nitratos y los acetatos son solubles.", "cationes": "*", "aniones": ["NO3-", "CH3COO-"], "resultado": "soluble" },
    { "texto": "Los cloruros, bromuros y yoduros son solubles, excepto los de Ag⁺, Pb²⁺ (y Hg₂²⁺).", "cationes": "*", "aniones": ["Cl-", "Br-", "I-"], "resultado": "soluble", "excepto": ["Ag+", "Pb2+"], "resultadoExcepcion": "insoluble" },
    { "texto": "Los sulfatos son solubles, excepto los de Ba²⁺, Sr²⁺, Pb²⁺ (insolubles) y los de Ca²⁺ y Ag⁺ (poco solubles).", "cationes": "*", "aniones": ["SO4^2-"], "resultado": "soluble", "excepto": ["Ba2+", "Sr2+", "Pb2+"], "resultadoExcepcion": "insoluble" },
    { "texto": "Los carbonatos, fosfatos y cromatos son insolubles, excepto los de alcalinos y amonio.", "cationes": "*", "aniones": ["CO3^2-", "PO4^3-", "CrO4^2-"], "resultado": "insoluble" },
    { "texto": "Los hidróxidos son insolubles, excepto los de alcalinos y Ba²⁺ (solubles) y los de Ca²⁺ y Sr²⁺ (poco solubles).", "cationes": "*", "aniones": ["OH-"], "resultado": "insoluble" },
    { "texto": "Los sulfuros son insolubles, excepto los de alcalinos, amonio y Ca²⁺, Sr²⁺ y Ba²⁺.", "cationes": "*", "aniones": ["S^2-"], "resultado": "insoluble" }
  ],
  "excepciones": [
