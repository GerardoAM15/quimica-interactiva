    { "cation": "Ag+", "anion": "SO4^2-", "resultado": "poco" },
    { "cation": "Pb2+", "anion": "Cl-", "resultado": "poco", "nota": "Poco soluble en frío; más soluble en agua caliente." },
    { "cation": "Pb2+", "anion": "Br-", "resultado": "poco" },
