    { "cation": "Ba2+", "anion": "OH-", "resultado": "soluble" },
    { "cation": "Ca2+", "anion": "S^2-", "resultado": "soluble", "nota": "Se hidroliza parcialmente (Brown la considera soluble)." },
    { "cation": "Sr2+", "anion": "S^2-", "resultado": "soluble", "nota": "Se hidroliza parcialmente." },
    { "cation": "Ba2+", "anion": "S^2-", "resultado": "soluble", "nota": "Se hidroliza parcialmente." },
    { "cation": "Mg2+", "anion": "S^2-", "resultado": "reacciona", "nota": "El MgS se hidroliza en agua: Mg(OH)₂ + H₂S." },
    { "cation": "Al3+", "anion": "S^2-", "resultado": "reacciona", "nota": "El Al₂S₃ se hidroliza: precipita Al(OH)₃ y se libera H₂S." },
    { "cation": "Fe3+", "anion": "S^2-", "resultado": "reacciona", "nota": "El Fe³⁺ oxida al S²⁻; se forman FeS y S." },
    { "cation": "Al3+", "anion": "CO3^2-", "resultado": "reacciona", "nota": "No existe en agua: precipita Al(OH)₃ y se libera CO₂." },
    { "cation": "Fe3+", "anion": "CO3^2-", "resultado": "reacciona", "nota": "No existe en agua: precipita Fe(OH)₃ y se libera CO₂." },
    { "cation": "NH4+", "anion": "OH-", "resultado": "reacciona", "nota": "NH₄⁺ + OH⁻ → NH₃ + H₂O (no hay «hidróxido de amonio» como sólido)." },
    { "cation": "Ag+", "anion": "OH-", "resultado": "insoluble", "nota": "Precipita óxido de plata, Ag₂O (pardo)." }
